# Port for the Llama Controller UI
LLAMA_CONTROLLER_PORT=5000

# Port for the llama-server inference API
LLAMA_SERVER_PORT=8080

# The URL of the Llama Server UI shown in the controller
LLAMA_SERVER_URL="http://localhost:8080"

# Optional: When running natively (not in container), override the data and build-profiles directories.
# These variables are ignored when running via docker-compose, which mounts directories instead.
# LLAMA_CONTROLLER_DATA_DIR=~/vms/data/llama/data
# LLAMA_CONTROLLER_BUILD_PROFILES_DIR=~/vms/data/llama/cache
